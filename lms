#!/bin/bash
set -euo pipefail

SAIL="./vendor/bin/sail"
DOCKER_PROD=(sudo docker compose -f compose.prod.yaml)
NETWORK_CHECK="./scripts/docker-network-check"

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

prod_artisan() {
    "${DOCKER_PROD[@]}" exec app php artisan "$@"
}

prod_preflight() {
    local missing=0

    for file in .env compose.prod.yaml docker/8.4-trixie/Dockerfile docker/8.4-trixie/entrypoint.sh; do
        if [ ! -f "$file" ]; then
            echo "Falta $file"
            missing=1
        fi
    done

    for binary in curl docker git ip python3 sudo; do
        if ! command -v "$binary" >/dev/null 2>&1; then
            echo "$binary no esta disponible en PATH."
            missing=1
        fi
    done

    if [ "$missing" -ne 0 ]; then
        exit 1
    fi

    "${DOCKER_PROD[@]}" config >/dev/null
}

network_check() {
    local environment="${1:-}"

    if [ ! -x "$NETWORK_CHECK" ]; then
        echo "Falta el ejecutable $NETWORK_CHECK"
        exit 1
    fi

    if [ "$environment" = "prod" ]; then
        LMS_DOCKER_SUDO=1 "$NETWORK_CHECK" prod
    else
        "$NETWORK_CHECK" "$environment"
    fi
}

default_route_snapshot() {
    ip -4 route show default
}

network_diagnostics() {
    echo "Diagnóstico de rutas IPv4:"
    ip -4 route show || true
    echo "Diagnóstico de redes Docker:"
    sudo docker network ls || true
    echo "Diagnóstico DNS:"
    getent ahostsv4 www.cloudflare.com || true
}

verify_default_route() {
    local before="$1"
    local after
    after=$(default_route_snapshot)

    if [ -z "$after" ] || [ "$after" != "$before" ]; then
        echo "ERROR: la ruta por defecto cambió."
        echo "Antes: ${before:-<sin ruta>}"
        echo "Después: ${after:-<sin ruta>}"
        network_diagnostics
        return 1
    fi
}

prod_external_health() {
    echo "Verificando salida HTTPS desde el contenedor app..."
    "${DOCKER_PROD[@]}" exec -T app curl --fail --silent --show-error \
        --connect-timeout 5 --max-time 10 \
        https://www.cloudflare.com/cdn-cgi/trace >/dev/null
}

prod_effective_subnet() {
    local expected actual container_id network_id
    expected=$("${DOCKER_PROD[@]}" config --format json | python3 -c \
        'import json,sys; print(json.load(sys.stdin)["networks"]["alumco-prod"]["ipam"]["config"][0]["subnet"])')
    container_id=$("${DOCKER_PROD[@]}" ps -q app)
    if [ -z "$container_id" ]; then
        echo "ERROR: no se encontró el contenedor app."
        return 1
    fi
    network_id=$(sudo docker inspect \
        --format '{{range $name, $network := .NetworkSettings.Networks}}{{$network.NetworkID}}{{"\n"}}{{end}}' \
        "$container_id" | head -n 1)
    if [ -z "$network_id" ]; then
        echo "ERROR: no se pudo identificar la red del contenedor app."
        return 1
    fi
    actual=$(sudo docker network inspect "$network_id" \
        --format '{{(index .IPAM.Config 0).Subnet}}')
    if [ "$actual" != "$expected" ]; then
        echo "ERROR: la subred efectiva es $actual, pero Compose requiere $expected."
        return 1
    fi
    echo "Subred efectiva confirmada: $actual"
}

prod_build() {
    echo "Compilando imagenes de produccion..."
    "${DOCKER_PROD[@]}" build "$@" app web
}

prod_up() {
    local route_before

    network_check prod
    route_before=$(default_route_snapshot)
    echo "Iniciando contenedores de produccion..."
    "${DOCKER_PROD[@]}" up -d
    verify_default_route "$route_before" || return 1
    network_check prod || {
        network_diagnostics
        return 1
    }
}

prod_down() {
    echo "Apagando contenedores de produccion..."
    "${DOCKER_PROD[@]}" down
}

prod_health() {
    local port_output=""
    local host_port=""
    local attempt
    local max_attempts=5
    local sleep_time=0.5

    echo "Obteniendo puerto del servicio web..."
    for attempt in $(seq 1 10); do
        # Timeout de 5s para el comando docker port por si docker daemon no responde
        port_output=$(timeout 5 "${DOCKER_PROD[@]}" port web 80 2>/dev/null) || port_output=""
        host_port="${port_output##*:}"
        if [ -n "$host_port" ]; then
            break
        fi
        printf "."
        sleep 1
    done
    echo ""

    if [ -z "$host_port" ]; then
        echo "Error: No se pudo resolver el puerto publicado del servicio web."
        exit 1
    fi

    local url="http://127.0.0.1:${host_port}/up"
    echo "Verificando salud en $url..."
    
    for attempt in $(seq 1 "$max_attempts"); do
        printf "Intento %02d/%d: " "$attempt" "$max_attempts"
        if curl --fail --silent --connect-timeout 5 --max-time 5 "$url" >/dev/null; then
            echo "EXITO"
            return 0
        fi
        echo "esperando..."
        sleep "$sleep_time"
    done

    echo "ERROR: El health check falló después de $max_attempts intentos."
    echo "Detalle del error final:"
    curl --fail --show-error --connect-timeout 5 --max-time 5 "$url" || true
    exit 1
}

prod_deploy() {
    prod_preflight
    network_check prod

    echo ">>> Iniciando despliegue de producción..."

    echo ">>> [1/7] Actualizando código fuente..."
    git pull origin main
    prod_preflight
    network_check prod

    echo ">>> [2/7] Compilando imágenes..."
    prod_build "$@"

    echo ">>> [3/7] Modo mantenimiento: ON"
    prod_artisan down --render="errors::503" || true

    echo ">>> [4/7] Reiniciando contenedores..."
    prod_up

    echo ">>> [5/7] Reiniciando colas..."
    prod_artisan queue:restart || true

    echo ">>> [6/7] Modo mantenimiento: OFF"
    prod_artisan up || true

    echo ">>> [7/7] Verificando salud del sistema..."
    prod_external_health || {
        network_diagnostics
        return 1
    }
    prod_health

    echo ">>> DESPLIEGUE FINALIZADO CORRECTAMENTE."
}

prod_network_migrate() {
    local route_before

    prod_preflight
    network_check prod
    route_before=$(default_route_snapshot)

    echo "Recreando la red de producción sin eliminar volúmenes..."
    "${DOCKER_PROD[@]}" down --remove-orphans
    "${DOCKER_PROD[@]}" up -d

    verify_default_route "$route_before" || return 1
    network_check prod || {
        network_diagnostics
        return 1
    }
    prod_effective_subnet || {
        network_diagnostics
        return 1
    }
    prod_external_health || {
        network_diagnostics
        return 1
    }
    prod_health
    echo "Migración de red finalizada; los volúmenes prod-mysql y prod-redis se conservaron."
}

prod_clean() {
    echo "Limpiando imagenes huerfanas..."
    sudo docker image prune -f
}

show_help() {
    printf "Uso: ./lms [comando] [argumentos]\n\n"
    printf "%-15s %s\n" "DEV:" ""
    printf "  %-15s %s\n" "dev-start" "inicia sail"
    printf "  %-15s %s\n" "dev-rebuild" "reconstruye sail sin cache"
    printf "  %-15s %s\n" "dev-stop" "apaga sail"
    printf "  %-15s %s\n" "network-check" "valida red, rutas, DNS y HTTPS (dev|prod)"
    printf "\n%-15s %s\n" "PROD:" ""
    printf "  %-15s %s\n" "prod-deploy" "pull, build, up, queue restart y health check"
    printf "  %-15s %s\n" "prod-build" "compila imagenes app/web; acepta --no-cache"
    printf "  %-15s %s\n" "prod-up" "levanta contenedores"
    printf "  %-15s %s\n" "prod-down" "baja contenedores"
    printf "  %-15s %s\n" "prod-health" "valida /up"
    printf "  %-15s %s\n" "prod-network-migrate" "recrea red/contenedores sin borrar volúmenes"
    printf "  %-15s %s\n" "prod-artisan" "php artisan (ej: migrate:status)"
    printf "  %-15s %s\n" "prod-exec" "comando libre en un servicio"
    printf "  %-15s %s\n" "prod-clean" "libera imagenes huerfanas"
    printf "\nEjemplos:\n"
    printf "  ./lms prod-artisan migrate:status\n"
    printf "  ./lms prod-artisan db:seed --force\n"
    printf "  ./lms prod-artisan storage:link\n"
    printf "  ./lms prod-artisan route:list --path=livewire\n"
}

case "$cmd" in
    dev-start)
        network_check dev
        echo "Iniciando server dev..."
        $SAIL up -d
        ;;
    dev-rebuild)
        echo "Reconstruyendo imagenes de dev sin cache..."
        $SAIL build --no-cache
        ;;
    dev-stop)
        echo "Apagando server dev..."
        $SAIL stop
        ;;
    prod-deploy)
        prod_deploy "$@"
        ;;
    prod-build)
        prod_preflight
        prod_build "$@"
        ;;
    prod-up | prod-start)
        prod_preflight
        prod_up
        ;;
    prod-down | prod-stop)
        prod_preflight
        prod_down
        ;;
    prod-health)
        prod_preflight
        prod_health
        ;;
    prod-network-migrate)
        prod_network_migrate
        ;;
    network-check)
        network_check "${1:-}"
        ;;
    prod-clean)
        prod_clean
        ;;
    prod-artisan)
        prod_preflight
        echo "Ejecutando artisan en produccion..."
        prod_artisan "$@"
        ;;
    prod-exec)
        prod_preflight
        service="${1:-}"
        if [ -z "$service" ]; then
            echo "Debes indicar el servicio."
            exit 1
        fi
        shift
        echo "Ejecutando comando en $service..."
        "${DOCKER_PROD[@]}" exec "$service" "$@"
        ;;
    help | --help | -h)
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
