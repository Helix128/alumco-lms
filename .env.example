APP_NAME=Alumco
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# Docker publica servicios solo en el host. El túnel de producción debe apuntar
# a http://127.0.0.1:${APP_PORT}.
DOCKER_HOST_BIND=127.0.0.1
DOCKER_PROD_SUBNET=172.30.250.0/27
DOCKER_DEV_SUBNET=172.30.250.32/27
# Antes de cambiar un CIDR ejecuta: ./lms network-check dev|prod
# Si colisiona con una LAN, VPN, ruta o red Docker, elige otro bloque RFC1918
# entre /24 y /28 que no se solape. Dev y prod tampoco deben solaparse.

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DEMO_SEED_PROGRESS=false
MEDIA_DISK=local_media
MEDIA_TEMP_DISK=media_temp
MEDIA_INTERNAL_PREFIX=/protected-media

# S3 / Cloudflare R2 (use MEDIA_DISK=s3 to enable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

WWWUSER=1000
WWWGROUP=1000
FORWARD_REDIS_PORT=6379

APP_TIMEZONE=America/Santiago
